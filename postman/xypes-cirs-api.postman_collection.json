              "mode": "raw",
              "raw": "{\n  \"incidentId\": 999999,\n  \"responderId\": {{responderId}}\n}"
            },
            "url": "{{baseUrl}}{{apiBase}}/assignments"
          }
        },
        {
          "name": "GET Location Missing (404 sample)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status code is 404', function () { pm.response.to.have.status(404); });"] } }],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}{{apiBase}}/locations/999999"
          }
        }
