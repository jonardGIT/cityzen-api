{
  "info": {
    "name": "Xypes CIRS API",
    "description": "Postman collection aligned with the current Express, Prisma, API key, and JWT authentication flows. Set {{apiKey}} to a configured API_KEYS/API_KEY value before calling protected resource endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "apiBase", "value": "/api/v1" },
    { "key": "apiKey", "value": "test-key", "type": "string" },
    { "key": "jwtToken", "value": "", "type": "string" },
    { "key": "adminJwtToken", "value": "", "type": "string" },
    { "key": "dispatcherJwtToken", "value": "", "type": "string" },
    { "key": "viewerJwtToken", "value": "", "type": "string" },
    { "key": "viewerEmail", "value": "", "type": "string" },
    { "key": "managedUserEmail", "value": "", "type": "string" },
    { "key": "citizenId", "value": "", "type": "string" },
    { "key": "agencyId", "value": "", "type": "string" },
    { "key": "responderId", "value": "", "type": "string" },
    { "key": "statusId", "value": "", "type": "string" },
    { "key": "categoryId", "value": "", "type": "string" },
    { "key": "severityId", "value": "", "type": "string" },
    { "key": "locationId", "value": "", "type": "string" },
    { "key": "incidentId", "value": "", "type": "string" },
    { "key": "assignmentId", "value": "", "type": "string" },
    { "key": "userId", "value": "", "type": "string" },
    { "key": "currentUserId", "value": "", "type": "string" },
    { "key": "viewerUserId", "value": "", "type": "string" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{jwtToken}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET Health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "var body = pm.response.json();",
                  "pm.expect(body.status).to.eql('ok');"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}{{apiBase}}/health"
          }
        },
        {
          "name": "GET OpenAPI JSON",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "var body = pm.response.json();",
                  "pm.expect(body).to.have.property('openapi');"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}{{apiBase}}/openapi.json"
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register Viewer",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('viewerEmail', 'viewer.' + Date.now() + '@xypes.local');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "var body = pm.response.json();",
                  "pm.expect(body).to.have.property('token');",
                  "pm.collectionVariables.set('viewerJwtToken', body.token);",
                  "pm.collectionVariables.set('viewerUserId', body.user.id);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Viewer\",\n  \"email\": \"{{viewerEmail}}\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": "{{baseUrl}}{{apiBase}}/auth/register"
          }
        },
        {
          "name": "Login Seeded Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "var body = pm.response.json();",
                  "pm.expect(body.user.role).to.eql('SUPER_ADMIN');",
                  "pm.collectionVariables.set('adminJwtToken', body.token);",
                  "pm.collectionVariables.set('jwtToken', body.token);",
                  "pm.collectionVariables.set('currentUserId', body.user.id);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@xypes.local\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": "{{baseUrl}}{{apiBase}}/auth/login"
          }
        },
        {
          "name": "Login Seeded Dispatcher",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "var body = pm.response.json();",
                  "pm.expect(body.user.role).to.eql('DISPATCHER');",
                  "pm.collectionVariables.set('dispatcherJwtToken', body.token);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"dispatcher@xypes.local\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": "{{baseUrl}}{{apiBase}}/auth/login"
          }
        },
        {
          "name": "GET Current User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "var body = pm.response.json();",
                  "pm.expect(body).to.have.property('id');",
                  "pm.collectionVariables.set('currentUserId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}{{apiBase}}/auth/me"
          }
        }
