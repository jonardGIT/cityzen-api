# Copy to .env.development for local development.
# Use .env in production environments.
NODE_ENV=development
PORT=3000
API_BASE_PATH=/api/v1
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173
TRUST_PROXY=false
JWT_SECRET=replace-with-a-strong-random-secret
MFA_ENCRYPTION_KEY=replace-with-a-separate-strong-random-secret
DATABASE_URL=postgresql://postgres:replace-with-db-password@localhost:5432/xypes_cirs
SUPABASE_AUTH_ENABLED=false
SUPABASE_JWT_ENABLED=false
SUPABASE_TOTP_ENABLED=false
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_AUTH_AUTO_CONFIRM_EMAIL=true
SUPABASE_PASSWORD_RESET_REDIRECT_URL=http://localhost:5173/reset-password
API_KEYS=replace-with-api-key
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Sentry backend monitoring.
# Copy the raw DSN URL from Sentry Project Settings > Client Keys (DSN).
# Do not include a `dsn:` prefix or quotes unless the value itself contains them.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_SEND_DEFAULT_PII=false
SENTRY_TRACES_SAMPLE_RATE=0.1
