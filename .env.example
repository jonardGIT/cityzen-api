# Copy to .env.development for local development.
# Use .env in production environments.
NODE_ENV=development
PORT=3000
API_BASE_PATH=/api/v1
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173
TRUST_PROXY=false
JWT_SECRET=replace-with-a-strong-random-secret
MFA_ENCRYPTION_KEY=replace-with-a-separate-strong-random-secret
# Runtime connection for the API.
# If you use the Supabase transaction pooler, keep the PgBouncer parameters.
DATABASE_URL=postgresql://postgres:replace-with-db-password@aws-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&pool_timeout=20

# Direct connection for Prisma migrations and schema commands.
DIRECT_URL=postgresql://postgres:replace-with-db-password@db.your-project-ref.supabase.co:5432/postgres
SUPABASE_AUTH_ENABLED=false
SUPABASE_JWT_ENABLED=false
SUPABASE_TOTP_ENABLED=false
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_AUTH_AUTO_CONFIRM_EMAIL=true
SUPABASE_PASSWORD_RESET_REDIRECT_URL=http://localhost:5173/reset-password
SUPABASE_STORAGE_ENABLED=false
SUPABASE_STORAGE_BUCKET=incident-media
SUPABASE_STORAGE_MAX_UPLOAD_BYTES=10485760
SUPABASE_STORAGE_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/heic,image/heif,video/mp4,video/quicktime,application/pdf
SUPABASE_STORAGE_ARCHIVE_ENABLED=true
SUPABASE_STORAGE_ARCHIVE_PREFIX=archive/incidents
ARCHIVE_RECORDS_ENABLED=true
API_KEYS=replace-with-api-key
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
JSON_BODY_LIMIT=12mb

# Sentry backend monitoring.
# Copy the raw DSN URL from Sentry Project Settings > Client Keys (DSN).
# Do not include a `dsn:` prefix or quotes unless the value itself contains them.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_SEND_DEFAULT_PII=false
SENTRY_TRACES_SAMPLE_RATE=0.1
