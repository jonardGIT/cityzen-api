# ╔══════════════════════════════════════════════════════════════════════╗
# ║  XYPES CIRS API — Environment Configuration                       ║
# ║                                                                    ║
# ║  Copy this file:                                                   ║
# ║    cp .env.example .env.development   (local dev)                  ║
# ║    cp .env.example .env               (production)                 ║
# ║                                                                    ║
# ║  NEVER commit .env or .env.development — they contain secrets.     ║
# ║  Only .env.example and .env.test may be committed.                 ║
# ╚══════════════════════════════════════════════════════════════════════╝

# ──────────────────────────────────────────────────────
#  Core Settings
# ──────────────────────────────────────────────────────

# "development" | "production" | "test"
NODE_ENV=development

# Port the API listens on.
PORT=3000

# Bind address. Use 0.0.0.0 for Docker / VPS, 127.0.0.1 for local.
HOST=0.0.0.0

# Base path for all routes. Default: /api/v1
API_BASE_PATH=/api/v1

# "error" | "warn" | "info" | "debug"
LOG_LEVEL=info

# Allowed origins for CORS. Comma-separated.
# Example: http://localhost:5173,https://your-dashboard.vercel.app
CORS_ORIGIN=http://localhost:5173

# Set true when behind a reverse proxy (nginx, Caddy, Cloud Run, etc.).
TRUST_PROXY=false

# Maximum JSON body size accepted by the API.
JSON_BODY_LIMIT=12mb

# ──────────────────────────────────────────────────────
#  Database (PostgreSQL via Prisma)
# ──────────────────────────────────────────────────────

# Runtime connection — used by the running API.
# For Supabase: use the transaction pooler URL (port 6543, pgbouncer params).
# For local Postgres: postgresql://user:password@localhost:5432/dbname
DATABASE_URL=postgresql://postgres:your-password@localhost:5432/xypes_cirs?schema=public

# Direct connection — used by Prisma CLI for migrations and schema push.
# For Supabase: use the session pooler or direct connection (port 5432).
# For local Postgres: same as DATABASE_URL.
DIRECT_URL=postgresql://postgres:your-password@localhost:5432/xypes_cirs?schema=public

# ──────────────────────────────────────────────────────
#  Feature Selection
#
#  The API supports multiple authentication, storage,
#  and data-management modes. Set these based on your
#  infrastructure. When omitted, legacy SUPABASE_*_ENABLED
#  flags are used as fallback, then finally safe defaults.
# ──────────────────────────────────────────────────────

# Optional profile label (for logging / identification only).
# FEATURE_PROFILE_NAME=development

# "local" — app manages users, bcrypt passwords, local JWT
# "supabase" — Supabase Auth manages users and identity
# Default: "local" (unless SUPABASE_AUTH_ENABLED=true)
# FEATURE_AUTH_PROVIDER=local

# "app-jwt" — API issues its own JWTs (requires JWT_SECRET)
# "supabase-jwt" — tokens come from Supabase Auth (requires SUPABASE_URL + keys)
# Default: "app-jwt" (unless SUPABASE_JWT_ENABLED=true)
# FEATURE_TOKEN_MODE=app-jwt

# "disabled" — no MFA
# "local-totp" — API generates and verifies TOTP codes (requires MFA_ENCRYPTION_KEY)
# "supabase-totp" — Supabase handles MFA enrollment + verification
# Default: "local-totp" (unless SUPABASE_TOTP_ENABLED=true)
# FEATURE_MFA_MODE=local-totp

# "disabled" — no media upload
# "supabase-storage" — incident media stored in Supabase Storage buckets
# Default: "disabled" (unless SUPABASE_STORAGE_ENABLED=true)
# FEATURE_MEDIA_STORAGE=disabled

# "hard-delete" — DELETE removes the database row permanently
# "archive" — DELETE sets archivedAt; row can be restored via POST /:id/restore
# Default: "archive"
# FEATURE_RECORD_DELETION=archive

# ──────────────────────────────────────────────────────
#  Authentication & Tokens
# ──────────────────────────────────────────────────────

# Required when FEATURE_TOKEN_MODE=app-jwt.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# MUST be at least 32 characters. Keep secret.
JWT_SECRET=replace-with-a-strong-random-secret

# Required when FEATURE_MFA_MODE=local-totp.
# Used to AES-256-GCM encrypt TOTP secrets at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MFA_ENCRYPTION_KEY=replace-with-a-separate-strong-random-secret

# Name shown in authenticator apps (e.g. "CIRS"). Optional.
# MFA_ISSUER=CIRS

# ──────────────────────────────────────────────────────
#  API Key Protection
#
#  Every non-bypass route requires a valid x-api-key header.
#  Bypass paths: /health, /auth/**, /openapi.json, /docs
# ──────────────────────────────────────────────────────

# Comma-separated list of accepted API keys.
# Generate with: node -e "console.log('sk_' + require('crypto').randomBytes(48).toString('hex'))"
# Example: API_KEYS=sk_abc123,sk_partner456,sk_qa789
# API_KEYS=

# Fallback: single key (used only when API_KEYS is empty).
# API_KEY=

# ──────────────────────────────────────────────────────
#  Rate Limiting
# ──────────────────────────────────────────────────────

# Master switch. Default: true
RATE_LIMIT_ENABLED=true

# Global: time window in ms and max requests per client IP.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# "memory" — in-process store (default; fine for single-instance)
# "database" — Postgres-backed (required for multi-instance / PM2 cluster)
# RATE_LIMIT_STORE=memory

# Auth login rate limit (keyed by email + IP).
# AUTH_LOGIN_RATE_LIMIT_WINDOW_MS=900000
# AUTH_LOGIN_RATE_LIMIT_MAX_REQUESTS=10

# Incident media upload rate limit (keyed by user + IP).
# INCIDENT_MEDIA_UPLOAD_RATE_LIMIT_WINDOW_MS=600000
# INCIDENT_MEDIA_UPLOAD_RATE_LIMIT_MAX_REQUESTS=10

# ──────────────────────────────────────────────────────
#  Supabase Integration
#
#  Only required when using Supabase auth/storage features.
#  When FEATURE_AUTH_PROVIDER=local, all of these can be omitted.
# ──────────────────────────────────────────────────────

# Legacy feature flags — prefer FEATURE_* above.
# SUPABASE_AUTH_ENABLED=false
# SUPABASE_JWT_ENABLED=false
# SUPABASE_TOTP_ENABLED=false
# SUPABASE_STORAGE_ENABLED=false

# Supabase project connection. Required for any Supabase feature.
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_ANON_KEY=eyJhbG...
# SUPABASE_SERVICE_ROLE_KEY=eyJhbG...

# Auto-confirm new user emails (dev convenience; never true in production).
# SUPABASE_AUTH_AUTO_CONFIRM_EMAIL=true

# URL users are redirected to after clicking the password reset link.
# SUPABASE_PASSWORD_RESET_REDIRECT_URL=http://localhost:5173/reset-password

# ── Supabase Storage (media uploads) ──
# SUPABASE_STORAGE_BUCKET=incident-media
# SUPABASE_STORAGE_MAX_UPLOAD_BYTES=10485760
# SUPABASE_STORAGE_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/heic,image/heif,video/mp4,video/quicktime,application/pdf

# "public" — direct public URLs
# "signed" — time-limited signed URLs (recommended for production)
# SUPABASE_STORAGE_ACCESS_MODE=signed
# SUPABASE_STORAGE_SIGNED_URL_TTL_SECONDS=900

# When archive mode is on, media for archived incidents is moved here.
# SUPABASE_STORAGE_ARCHIVE_ENABLED=true
# SUPABASE_STORAGE_ARCHIVE_PREFIX=archive/incidents

# Malware scan webhook (called after upload; optional).
# SUPABASE_STORAGE_SCAN_WEBHOOK_URL=

# ──────────────────────────────────────────────────────
#  Archive / Soft-delete
# ──────────────────────────────────────────────────────

# Legacy flag — prefer FEATURE_RECORD_DELETION above. Default: true
ARCHIVE_RECORDS_ENABLED=true

# ──────────────────────────────────────────────────────
#  Password Reset
# ──────────────────────────────────────────────────────

# Token time-to-live in minutes. Default: 30
# PASSWORD_RESET_TOKEN_TTL_MINUTES=30

# Webhook the API calls to deliver the reset link to the user.
# In production the reset will fail-closed (429) if this is not set.
# PASSWORD_RESET_DELIVERY_WEBHOOK_URL=https://your-dashboard.example.com/password-reset

# ──────────────────────────────────────────────────────
#  Security Alerting
#
#  Webhook called when anomalous activity is detected
#  (brute-force login, MFA abuse, privileged changes, etc.).
#  All threshold/window vars below are optional; sane
#  defaults are baked in. Alerts are disabled when the
#  webhook URL is empty.
# ──────────────────────────────────────────────────────

# SECURITY_ALERT_WEBHOOK_URL=https://your-dashboard.example.com/alerts

# Login failure anomaly
# SECURITY_ALERT_LOGIN_FAILURE_THRESHOLD=10
# SECURITY_ALERT_LOGIN_FAILURE_WINDOW_MS=900000

# Password reset anomaly
# SECURITY_ALERT_PASSWORD_RESET_THRESHOLD=5
# SECURITY_ALERT_PASSWORD_RESET_WINDOW_MS=3600000

# Password reset confirm failure
# SECURITY_ALERT_PASSWORD_RESET_CONFIRM_FAILURE_THRESHOLD=5
# SECURITY_ALERT_PASSWORD_RESET_CONFIRM_FAILURE_WINDOW_MS=900000

# Privileged recovery blocked
# SECURITY_ALERT_PRIVILEGED_RECOVERY_BLOCKED_THRESHOLD=3
# SECURITY_ALERT_PRIVILEGED_RECOVERY_BLOCKED_WINDOW_MS=3600000

# MFA setup abuse
# SECURITY_ALERT_MFA_SETUP_THRESHOLD=5
# SECURITY_ALERT_MFA_SETUP_WINDOW_MS=3600000

# Session churn
# SECURITY_ALERT_SESSION_CHURN_THRESHOLD=10
# SECURITY_ALERT_SESSION_CHURN_WINDOW_MS=3600000

# Refresh token failure
# SECURITY_ALERT_REFRESH_FAILURE_THRESHOLD=10
# SECURITY_ALERT_REFRESH_FAILURE_WINDOW_MS=900000

# Privileged user change
# SECURITY_ALERT_PRIVILEGED_USER_CHANGE_THRESHOLD=5
# SECURITY_ALERT_PRIVILEGED_USER_CHANGE_WINDOW_MS=3600000

# Media upload anomaly
# SECURITY_ALERT_MEDIA_UPLOAD_THRESHOLD=20
# SECURITY_ALERT_MEDIA_UPLOAD_WINDOW_MS=600000

# Media access anomaly
# SECURITY_ALERT_MEDIA_ACCESS_THRESHOLD=50
# SECURITY_ALERT_MEDIA_ACCESS_WINDOW_MS=600000

# ──────────────────────────────────────────────────────
#  Admin & Governance
# ──────────────────────────────────────────────────────

# Days after which a user's access review is considered stale. Default: 90
# ADMIN_ACCESS_REVIEW_STALE_DAYS=90

# ── Data Retention (governance dashboard) ──
# DATA_RETENTION_AUDIT_LOG_DAYS=365
# DATA_RETENTION_AUTH_SESSIONS_DAYS=90
# DATA_RETENTION_INCIDENT_RECORDS_DAYS=1825
# DATA_RETENTION_INCIDENT_MEDIA_DAYS=365
# DATA_RETENTION_CITIZEN_RECORDS_DAYS=1825
# DATA_RETENTION_PASSWORD_RESET_DAYS=1

# Legal hold — disables data purging when active.
# DATA_LEGAL_HOLD_ENABLED=false
# DATA_LEGAL_HOLD_CONTACT=legal@example.com

# ──────────────────────────────────────────────────────
#  Sentry Error Monitoring (optional)
#
#  Sentry stays disabled until SENTRY_DSN is set.
#  Get your DSN from Sentry → Project Settings → Client Keys.
# ──────────────────────────────────────────────────────

# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development
# SENTRY_RELEASE=
# SENTRY_SEND_DEFAULT_PII=false
# SENTRY_TRACES_SAMPLE_RATE=0.1
