{
  "name": "xypes-cirs-api",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "build:production": "tsx scripts/buildProduction.ts",
    "bootstrap:admin": "tsx scripts/bootstrapAdmin.ts",
    "docs:dashboard-config": "tsx scripts/generateDashboardCrudConfig.ts",
    "docs:dashboard-config:check": "npm run docs:dashboard-config && git diff --exit-code -- docs/dashboard-crud-config.json docs/dashboard-crud-config.flat.json",
    "seed:cagayan:generate": "tsx scripts/generateCagayanProvinceSeed.ts",
    "smoke:local": "tsx scripts/smokeLocal.ts",
    "smoke:remote": "tsx scripts/smokeRemote.ts",
    "start": "node dist/server.js",
    "dev": "dotenv -o -e .env.development -- nodemon --watch src --ext ts --exec \"tsx src/server.ts\"",
    "supabase:backfill-seed": "dotenv -o -e .env.development -- tsx scripts/backfillSupabaseSeedUsers.ts",
    "test:db:up": "sh ./scripts/runTestDbCompose.sh up -d",
    "test:db:down": "sh ./scripts/runTestDbCompose.sh down -v",
    "test:db:reset": "sh ./scripts/runTestDbCompose.sh exec -T postgres psql -U postgres -d xypes_test -f /workspace/prisma/reset-prisma-schema.sql",
    "test:db:seed": "sh ./scripts/runTestDbCompose.sh exec -T postgres psql -U postgres -d xypes_test -f /workspace/prisma/seed-data.sql",
    "test:local": "npm run test:db:up && npm run test:db:reset && npm run test:db:seed && npm test",
    "test": "node ./scripts/runJestWithTestDb.js",
    "test:development-db": "TEST_USE_DEVELOPMENT_DATABASE=true node ./scripts/runJestWithTestDb.js",
    "test:watch": "node ./scripts/runJestWithTestDb.js --watch",
    "test:coverage": "node ./scripts/runJestWithTestDb.js --coverage"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@prisma/client": "^5.8.0",
    "@sentry/node": "^10.47.0",
    "@supabase/supabase-js": "^2.101.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-validator": "^7.3.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "postgres": "^3.4.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.5.0",
    "@types/supertest": "^7.2.0",
    "@types/swagger-ui-express": "^4.1.8",
    "dotenv-cli": "^11.0.0",
    "embedded-postgres": "^18.3.0-beta.16",
    "esbuild": "^0.28.0",
    "jest": "^30.3.0",
    "openapi-types": "^12.1.3",
    "prisma": "^5.8.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
