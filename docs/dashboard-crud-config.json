          "allowedRoles": ["NATIONAL_ADMIN", "REGIONAL_DIRECTOR", "PROVINCIAL_ADMIN", "CITY_ADMIN"],
          "featureGate": {
            "feature": "recordDeletion",
            "requires": "archive"
