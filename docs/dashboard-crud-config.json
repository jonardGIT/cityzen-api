            "SYSTEM_ADMIN",
            "DEPARTMENT_MANAGER",
            "SUPERVISOR",
            "DISPATCHER",
            "RESPONDER"
          ]
        },
        "restore": {
          "method": "POST",
          "path": "/incidents/{id}/restore",
          "authRequired": true,
          "featureGate": {
            "feature": "recordDeletion",
            "requires": "archive"
          },
          "allowedRoles": [
            "SYSTEM_ADMIN",
            "DEPARTMENT_MANAGER",
            "SUPERVISOR",
            "DISPATCHER",
            "RESPONDER"
          ]
        },
        "mediaAccess": {
          "method": "GET",
          "path": "/incidents/{id}/media/{mediaId}",
          "authRequired": true,
          "allowedRoles": [
            "SYSTEM_ADMIN",
            "DEPARTMENT_MANAGER",
            "SUPERVISOR",
            "DISPATCHER",
            "RESPONDER",
            "CITIZEN_REPORTER",
            "AUDITOR"
          ],
          "notes": "Authenticated media access endpoint. The backend enforces incident-level authorization before resolving an access URL."
        },
        "mediaUpload": {
          "method": "POST",
          "path": "/incidents/media/upload",
          "authRequired": true,
          "featureGate": {
            "feature": "mediaStorage",
            "requires": "supabase-storage"
          },
          "allowedRoles": [
            "SYSTEM_ADMIN",
            "DEPARTMENT_MANAGER",
            "SUPERVISOR",
            "DISPATCHER",
            "RESPONDER",
            "CITIZEN_REPORTER"
          ],
          "notes": "Available only when the selected feature profile enables incident media uploads. Feature-aware OpenAPI output omits this operation when mediaStorage is disabled."
        }
      }
    },
