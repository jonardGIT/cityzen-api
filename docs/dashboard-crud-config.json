{
  "apiBasePath": "/api/v1",
  "auth": {
    "type": "bearer",
    "tokenHeader": "Authorization",
    "tokenPrefix": "Bearer",
    "bootstrap": {
      "loginPath": "/auth/login",
      "registerPath": "/auth/register",
      "mePath": "/auth/me",
      "citizenLinkPath": "/citizens/link-me",
      "incidentReportPath": "/incidents/report"
    }
  },
  "resources": [
    {
      "name": "citizens",
      "label": "Citizens",
      "primaryKey": "id",
      "routes": {
        "list": { "method": "GET", "path": "/citizens", "authRequired": false },
        "get": { "method": "GET", "path": "/citizens/{id}", "authRequired": false },
        "create": { "method": "POST", "path": "/citizens", "authRequired": false },
        "linkMe": {
          "method": "POST",
          "path": "/citizens/link-me",
          "authRequired": true,
          "allowedRoles": ["VIEWER"],
          "notes": "Creates or updates the authenticated viewer's linked citizen profile."
        },
        "update": {
          "method": "PATCH",
          "path": "/citizens/{id}",
          "authRequired": true,
          "allowedRoles": ["SUPER_ADMIN", "ADMIN"]
        },
        "delete": {
          "method": "DELETE",
          "path": "/citizens/{id}",
          "authRequired": true,
          "allowedRoles": ["SUPER_ADMIN", "ADMIN"]
        }
      }
    },
    {
      "name": "agencies",
      "label": "Agencies",
      "primaryKey": "id",
      "routes": {
        "list": { "method": "GET", "path": "/agencies", "authRequired": false },
        "get": { "method": "GET", "path": "/agencies/{id}", "authRequired": false },
        "create": {
          "method": "POST",
          "path": "/agencies",
          "authRequired": true,
          "allowedRoles": ["SUPER_ADMIN", "ADMIN"]
        },
        "update": {
          "method": "PATCH",
          "path": "/agencies/{id}",
          "authRequired": true,
          "allowedRoles": ["SUPER_ADMIN", "ADMIN"]
        },
        "delete": {
          "method": "DELETE",
          "path": "/agencies/{id}",
          "authRequired": true,
          "allowedRoles": ["SUPER_ADMIN", "ADMIN"]
        }
      }
    },
    {
      "name": "responders",
      "label": "Responders",
      "primaryKey": "id",
      "routes": {
        "list": { "method": "GET", "path": "/responders", "authRequired": false },
        "get": { "method": "GET", "path": "/responders/{id}", "authRequired": false },
        "create": {
          "method": "POST",
          "path": "/responders",
          "authRequired": true,
          "allowedRoles": ["SUPER_ADMIN", "ADMIN"]
        },
        "update": {
          "method": "PATCH",
          "path": "/responders/{id}",
          "authRequired": true,
          "allowedRoles": ["SUPER_ADMIN", "ADMIN"]
        },
        "delete": {
          "method": "DELETE",
          "path": "/responders/{id}",
          "authRequired": true,
          "allowedRoles": ["SUPER_ADMIN", "ADMIN"]
        }
      }
    },
    {
      "name": "statuses",
      "label": "Statuses",
      "primaryKey": "id",
      "routes": {
        "list": { "method": "GET", "path": "/statuses", "authRequired": false },
        "get": { "method": "GET", "path": "/statuses/{id}", "authRequired": false },
        "create": {
          "method": "POST",
          "path": "/statuses",
          "authRequired": true,
