{
  "apiBasePath": "/api/v1",
  "pilot": {
    "scope": "tuguegarao-first",
    "partnerLguExpansion": "planned",
    "governanceBaselineDoc": "docs/tuguegarao-pilot-governance-baseline.md",
    "notes": "CIRS pilot is Tuguegarao-first. City and barangay operations are the canonical scope; partner-LGU expansion is planned. National roles and surfaces are deferred until formal regional governance is enabled. Dashboard and mobile clients should treat this contract as the source of truth for canonical vs compatibility-only routes."
  },
  "auth": {
    "type": "bearer",
    "tokenHeader": "Authorization",
    "tokenPrefix": "Bearer",
    "bootstrap": {
      "loginPath": "/auth/login",
      "refreshPath": "/auth/refresh",
      "registerPath": "/auth/register",
      "mePath": "/auth/me",
      "logoutPath": "/auth/logout",
      "capabilitiesPath": "/users/capabilities",
      "citizenLinkPath": "/citizens/link-me",
      "incidentReportPath": "/incidents/report"
    },
    "optionalEndpoints": {
      "sessions": {
        "method": "GET",
        "path": "/auth/sessions",
        "authRequired": true,
        "featureGate": {
          "feature": "tokenMode",
          "requiresAnyOf": ["app-jwt", "supabase-jwt"]
        },
        "notes": "Available when tokenMode is app-jwt or supabase-jwt. Feature-aware OpenAPI output omits session inventory endpoints for other token modes."
      },
      "revokeSession": {
        "method": "DELETE",
        "path": "/auth/sessions/{id}",
        "authRequired": true,
        "featureGate": {
          "feature": "tokenMode",
          "requiresAnyOf": ["app-jwt", "supabase-jwt"]
        },
        "notes": "Available when tokenMode is app-jwt or supabase-jwt."
      },
      "mfaSetup": {
        "method": "POST",
        "path": "/auth/mfa/setup",
        "authRequired": true,
        "allowedRoles": [
          "NATIONAL_ADMIN",
          "REGIONAL_DIRECTOR",
          "PROVINCIAL_ADMIN",
          "CITY_ADMIN",
          "CITY_CONTENT_EDITOR",
          "DISPATCHER",
          "AUDITOR"
        ],
        "featureGate": {
          "feature": "mfaMode",
          "requiresAnyOf": ["local-totp", "supabase-totp"]
        },
        "notes": "Available only when MFA is enabled in the selected feature profile."
      },
      "mfaEnable": {
        "method": "POST",
        "path": "/auth/mfa/enable",
        "authRequired": true,
        "allowedRoles": [
          "NATIONAL_ADMIN",
          "REGIONAL_DIRECTOR",
          "PROVINCIAL_ADMIN",
          "CITY_ADMIN",
          "CITY_CONTENT_EDITOR",
          "DISPATCHER",
          "AUDITOR"
        ],
        "featureGate": {
          "feature": "mfaMode",
          "requiresAnyOf": ["local-totp", "supabase-totp"]
        },
        "notes": "Available only when MFA is enabled in the selected feature profile."
      },
      "mfaDisable": {
        "method": "POST",
        "path": "/auth/mfa/disable",
        "authRequired": true,
        "allowedRoles": [
          "NATIONAL_ADMIN",
          "REGIONAL_DIRECTOR",
          "PROVINCIAL_ADMIN",
          "CITY_ADMIN",
          "CITY_CONTENT_EDITOR",
          "DISPATCHER",
          "AUDITOR"
        ],
        "featureGate": {
          "feature": "mfaMode",
          "requiresAnyOf": ["local-totp", "supabase-totp"]
        },
        "notes": "Available only when MFA is enabled in the selected feature profile."
      }
    }
  },
