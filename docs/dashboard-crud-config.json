{
  "apiBasePath": "/api/v1",
  "auth": {
    "type": "bearer",
    "tokenHeader": "Authorization",
    "tokenPrefix": "Bearer",
    "bootstrap": {
      "loginPath": "/auth/login",
      "refreshPath": "/auth/refresh",
      "registerPath": "/auth/register",
      "mePath": "/auth/me",
      "logoutPath": "/auth/logout",
      "capabilitiesPath": "/users/capabilities",
      "citizenLinkPath": "/citizens/link-me",
      "incidentReportPath": "/incidents/report"
    },
    "optionalEndpoints": {
      "sessions": {
        "method": "GET",
        "path": "/auth/sessions",
        "authRequired": true,
        "featureGate": {
          "feature": "tokenMode",
          "requires": "app-jwt"
        },
        "notes": "Available only when tokenMode is app-jwt. Feature-aware OpenAPI output omits session inventory endpoints for other token modes."
      },
      "revokeSession": {
        "method": "DELETE",
        "path": "/auth/sessions/{id}",
        "authRequired": true,
        "featureGate": {
          "feature": "tokenMode",
          "requires": "app-jwt"
        },
        "notes": "Available only when tokenMode is app-jwt."
      },
      "mfaSetup": {
        "method": "POST",
        "path": "/auth/mfa/setup",
        "authRequired": true,
        "allowedRoles": ["SYSTEM_ADMIN", "DEPARTMENT_MANAGER", "SUPERVISOR", "DISPATCHER"],
        "featureGate": {
          "feature": "mfaMode",
          "requiresAnyOf": ["local-totp", "supabase-totp"]
        },
        "notes": "Available only when MFA is enabled in the selected feature profile."
      },
      "mfaEnable": {
        "method": "POST",
        "path": "/auth/mfa/enable",
        "authRequired": true,
        "allowedRoles": ["SYSTEM_ADMIN", "DEPARTMENT_MANAGER", "SUPERVISOR", "DISPATCHER"],
        "featureGate": {
          "feature": "mfaMode",
          "requiresAnyOf": ["local-totp", "supabase-totp"]
        },
        "notes": "Available only when MFA is enabled in the selected feature profile."
      },
      "mfaDisable": {
        "method": "POST",
        "path": "/auth/mfa/disable",
        "authRequired": true,
        "allowedRoles": ["SYSTEM_ADMIN", "DEPARTMENT_MANAGER", "SUPERVISOR", "DISPATCHER"],
        "featureGate": {
          "feature": "mfaMode",
          "requiresAnyOf": ["local-totp", "supabase-totp"]
        },
        "notes": "Available only when MFA is enabled in the selected feature profile."
      }
    }
  },
  "resources": [
    {
      "name": "citizens",
      "label": "Citizens",
      "primaryKey": "id",
      "routes": {
        "list": {
          "method": "GET",
          "path": "/citizens",
          "authRequired": true,
          "allowedRoles": ["SYSTEM_ADMIN", "DEPARTMENT_MANAGER"]
        },
        "get": {
          "method": "GET",
          "path": "/citizens/{id}",
          "authRequired": true,
          "allowedRoles": ["SYSTEM_ADMIN", "DEPARTMENT_MANAGER"]
        },
        "create": {
          "method": "POST",
          "path": "/citizens",
          "authRequired": true,
          "allowedRoles": ["SYSTEM_ADMIN", "DEPARTMENT_MANAGER"]
        },
        "linkMe": {
          "method": "POST",
          "path": "/citizens/link-me",
          "authRequired": true,
          "allowedRoles": ["CITIZEN_REPORTER"],
          "notes": "Creates or updates the authenticated citizen reporter's linked citizen profile. contactInfo is inferred from the authenticated email."
        },
        "update": {
          "method": "PATCH",
          "path": "/citizens/{id}",
          "authRequired": true,
          "allowedRoles": ["SYSTEM_ADMIN", "DEPARTMENT_MANAGER"]
        },
        "delete": {
          "method": "DELETE",
          "path": "/citizens/{id}",
          "authRequired": true,
          "allowedRoles": ["SYSTEM_ADMIN", "DEPARTMENT_MANAGER"]
        },
        "restore": {
          "method": "POST",
          "path": "/citizens/{id}/restore",
          "authRequired": true,
          "featureGate": {
            "feature": "recordDeletion",
            "requires": "archive"
          },
          "allowedRoles": ["SYSTEM_ADMIN", "DEPARTMENT_MANAGER"]
        }
      }
    },
