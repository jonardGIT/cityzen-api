    {
      "name": "incidents",
      "label": "Incidents",
      "primaryKey": "id",
      "routes": {
        "list": {
          "method": "GET",
          "path": "/incidents",
          "authRequired": true,
          "allowedRoles": ["SUPER_ADMIN", "ADMIN", "DISPATCHER", "RESPONDER", "VIEWER"],
          "notes": "VIEWER users only receive their own incidents."
        },
        "get": {
          "method": "GET",
          "path": "/incidents/{id}",
          "authRequired": true,
          "allowedRoles": ["SUPER_ADMIN", "ADMIN", "DISPATCHER", "RESPONDER", "VIEWER"],
          "notes": "VIEWER users can only access their own incident IDs."
        },
        "create": {
          "method": "POST",
          "path": "/incidents",
          "authRequired": true,
          "allowedRoles": ["SUPER_ADMIN", "ADMIN", "DISPATCHER", "RESPONDER"]
        },
        "report": {
          "method": "POST",
          "path": "/incidents/report",
          "authRequired": true,
          "allowedRoles": ["VIEWER"],
          "notes": "Citizen self-report endpoint. citizenId is inferred from authenticated user email."
        },
        "update": {
          "method": "PATCH",
          "path": "/incidents/{id}",
          "authRequired": true,
          "allowedRoles": ["SUPER_ADMIN", "ADMIN", "DISPATCHER", "RESPONDER"]
        },
        "delete": {
          "method": "DELETE",
          "path": "/incidents/{id}",
          "authRequired": true,
          "allowedRoles": ["SUPER_ADMIN", "ADMIN", "DISPATCHER", "RESPONDER"]
        }
      }
    },
