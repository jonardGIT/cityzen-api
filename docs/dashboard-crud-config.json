            "DISPATCHER",
            "AUDITOR"
          ]
        },
        "create": {
          "method": "POST",
          "path": "/cities-municipalities",
          "authRequired": true,
          "allowedRoles": ["NATIONAL_ADMIN", "REGIONAL_DIRECTOR", "PROVINCIAL_ADMIN"],
          "notes": "PROVINCIAL_ADMIN writes are limited by the backend to cities or municipalities inside the actor's province scope. CITY_ADMIN remains read-only for this resource."
        },
        "update": {
          "method": "PATCH",
          "path": "/cities-municipalities/{id}",
          "authRequired": true,
          "allowedRoles": ["NATIONAL_ADMIN", "REGIONAL_DIRECTOR", "PROVINCIAL_ADMIN"],
          "notes": "PROVINCIAL_ADMIN writes are limited by the backend to cities or municipalities inside the actor's province scope."
        },
        "delete": {
          "method": "DELETE",
          "path": "/cities-municipalities/{id}",
          "authRequired": true,
          "allowedRoles": ["NATIONAL_ADMIN", "REGIONAL_DIRECTOR", "PROVINCIAL_ADMIN"],
          "notes": "Delete archives the record when archive mode is enabled. PROVINCIAL_ADMIN archive access is limited to the actor's province scope."
        },
        "restore": {
          "method": "POST",
          "path": "/cities-municipalities/{id}/restore",
          "authRequired": true,
          "featureGate": {
            "feature": "recordDeletion",
            "requires": "archive"
          },
          "allowedRoles": ["NATIONAL_ADMIN", "REGIONAL_DIRECTOR", "PROVINCIAL_ADMIN"],
          "notes": "PROVINCIAL_ADMIN restore access is limited to archived records inside the actor's province scope."
        }
      }
    },
