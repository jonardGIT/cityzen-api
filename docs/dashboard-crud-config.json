{
  "apiBasePath": "/api/v1",
  "auth": {
    "type": "bearer",
    "tokenHeader": "Authorization",
    "tokenPrefix": "Bearer",
    "bootstrap": {
      "loginPath": "/auth/login",
      "refreshPath": "/auth/refresh",
      "registerPath": "/auth/register",
      "mePath": "/auth/me",
      "logoutPath": "/auth/logout",
      "capabilitiesPath": "/users/capabilities",
      "citizenLinkPath": "/citizens/link-me",
      "incidentReportPath": "/incidents/report"
    },
    "optionalEndpoints": {
      "sessions": {
        "method": "GET",
        "path": "/auth/sessions",
        "authRequired": true,
        "featureGate": {
          "feature": "tokenMode",
          "requires": "app-jwt"
        },
        "notes": "Available only when tokenMode is app-jwt. Feature-aware OpenAPI output omits session inventory endpoints for other token modes."
      },
      "revokeSession": {
        "method": "DELETE",
        "path": "/auth/sessions/{id}",
        "authRequired": true,
        "featureGate": {
          "feature": "tokenMode",
          "requires": "app-jwt"
        },
        "notes": "Available only when tokenMode is app-jwt."
      },
      "mfaSetup": {
        "method": "POST",
        "path": "/auth/mfa/setup",
        "authRequired": true,
        "allowedRoles": [
          "NATIONAL_ADMIN",
          "REGIONAL_DIRECTOR",
          "PROVINCIAL_ADMIN",
          "CITY_ADMIN",
          "CITY_CONTENT_EDITOR",
          "DISPATCHER",
          "AUDITOR"
        ],
        "featureGate": {
          "feature": "mfaMode",
          "requiresAnyOf": [
            "local-totp",
            "supabase-totp"
          ]
        },
        "notes": "Available only when MFA is enabled in the selected feature profile."
      },
      "mfaEnable": {
        "method": "POST",
        "path": "/auth/mfa/enable",
        "authRequired": true,
        "allowedRoles": [
          "NATIONAL_ADMIN",
          "REGIONAL_DIRECTOR",
          "PROVINCIAL_ADMIN",
          "CITY_ADMIN",
          "CITY_CONTENT_EDITOR",
          "DISPATCHER",
          "AUDITOR"
        ],
        "featureGate": {
          "feature": "mfaMode",
          "requiresAnyOf": [
            "local-totp",
            "supabase-totp"
          ]
        },
        "notes": "Available only when MFA is enabled in the selected feature profile."
      },
      "mfaDisable": {
        "method": "POST",
        "path": "/auth/mfa/disable",
        "authRequired": true,
        "allowedRoles": [
          "NATIONAL_ADMIN",
          "REGIONAL_DIRECTOR",
          "PROVINCIAL_ADMIN",
          "CITY_ADMIN",
          "CITY_CONTENT_EDITOR",
          "DISPATCHER",
          "AUDITOR"
        ],
        "featureGate": {
          "feature": "mfaMode",
          "requiresAnyOf": [
            "local-totp",
            "supabase-totp"
          ]
        },
        "notes": "Available only when MFA is enabled in the selected feature profile."
      }
    }
  },
  "resources": [
