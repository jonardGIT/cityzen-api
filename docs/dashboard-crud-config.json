    {
      "name": "incidents",
      "label": "Incidents",
      "primaryKey": "id",
      "routes": {
        "list": {
          "method": "GET",
          "path": "/incidents",
          "authRequired": true,
          "allowedRoles": [
            "SYSTEM_ADMIN",
            "DEPARTMENT_MANAGER",
            "SUPERVISOR",
            "DISPATCHER",
            "RESPONDER",
            "CITIZEN_REPORTER",
            "AUDITOR"
          ],
          "notes": "The backend applies role-aware scoping. Citizen reporters only receive their own incidents."
        },
        "get": {
          "method": "GET",
          "path": "/incidents/{id}",
          "authRequired": true,
          "allowedRoles": [
            "SYSTEM_ADMIN",
            "DEPARTMENT_MANAGER",
            "SUPERVISOR",
            "DISPATCHER",
            "RESPONDER",
            "CITIZEN_REPORTER",
            "AUDITOR"
          ],
          "notes": "The backend enforces per-role incident visibility. Citizen reporters can only access their own incident IDs."
        },
        "create": {
          "method": "POST",
          "path": "/incidents",
          "authRequired": true,
          "allowedRoles": [
            "SYSTEM_ADMIN",
            "DEPARTMENT_MANAGER",
            "SUPERVISOR",
            "DISPATCHER",
            "RESPONDER"
          ]
        },
        "report": {
          "method": "POST",
          "path": "/incidents/report",
          "authRequired": true,
          "allowedRoles": ["CITIZEN_REPORTER"],
          "notes": "Citizen self-report endpoint. citizenId is inferred from the authenticated user context."
        },
        "update": {
          "method": "PATCH",
          "path": "/incidents/{id}",
          "authRequired": true,
          "allowedRoles": [
            "SYSTEM_ADMIN",
            "DEPARTMENT_MANAGER",
            "SUPERVISOR",
            "DISPATCHER",
            "RESPONDER"
          ]
        },
        "delete": {
          "method": "DELETE",
          "path": "/incidents/{id}",
          "authRequired": true,
          "allowedRoles": [
            "SYSTEM_ADMIN",
            "DEPARTMENT_MANAGER",
            "SUPERVISOR",
            "DISPATCHER",
            "RESPONDER"
          ]
        },
        "restore": {
          "method": "POST",
          "path": "/incidents/{id}/restore",
          "authRequired": true,
          "allowedRoles": [
            "SYSTEM_ADMIN",
            "DEPARTMENT_MANAGER",
            "SUPERVISOR",
            "DISPATCHER",
            "RESPONDER"
          ]
        },
        "mediaAccess": {
          "method": "GET",
          "path": "/incidents/{id}/media/{mediaId}",
          "authRequired": true,
          "allowedRoles": [
            "SYSTEM_ADMIN",
            "DEPARTMENT_MANAGER",
            "SUPERVISOR",
            "DISPATCHER",
            "RESPONDER",
            "CITIZEN_REPORTER",
            "AUDITOR"
          ],
          "notes": "Authenticated media access endpoint. The backend enforces incident-level authorization before resolving an access URL."
        },
        "mediaUpload": {
          "method": "POST",
          "path": "/incidents/media/upload",
          "authRequired": true,
          "allowedRoles": [
            "SYSTEM_ADMIN",
            "DEPARTMENT_MANAGER",
            "SUPERVISOR",
            "DISPATCHER",
            "RESPONDER",
            "CITIZEN_REPORTER"
          ],
          "notes": "Available only when the selected feature profile enables incident media uploads."
        }
      }
    },
