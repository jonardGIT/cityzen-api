        }
      }
    },
    {
      "name": "locations",
      "label": "Locations",
      "primaryKey": "id",
      "routes": {
        "list": { "method": "GET", "path": "/locations", "authRequired": false },
        "get": { "method": "GET", "path": "/locations/{id}", "authRequired": false },
        "create": {
          "method": "POST",
          "path": "/locations",
          "authRequired": true,
          "allowedRoles": ["SUPER_ADMIN", "ADMIN"]
        },
        "update": {
          "method": "PATCH",
          "path": "/locations/{id}",
          "authRequired": true,
          "allowedRoles": ["SUPER_ADMIN", "ADMIN"]
