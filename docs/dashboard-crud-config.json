          "path": "/assignments",
          "authRequired": true,
          "allowedRoles": ["SUPER_ADMIN", "ADMIN", "DISPATCHER"]
        },
        "update": {
          "method": "PATCH",
          "path": "/assignments/{id}",
          "authRequired": true,
          "allowedRoles": ["SUPER_ADMIN", "ADMIN", "DISPATCHER"]
        },
        "delete": {
          "method": "DELETE",
          "path": "/assignments/{id}",
          "authRequired": true,
          "allowedRoles": ["SUPER_ADMIN", "ADMIN", "DISPATCHER"]
        }
      }
    },
    {
      "name": "users",
      "label": "Users",
      "primaryKey": "id",
      "routes": {
        "list": {
          "method": "GET",
          "path": "/users",
          "authRequired": true,
          "allowedRoles": ["SUPER_ADMIN", "ADMIN"]
        },
        "get": {
          "method": "GET",
          "path": "/users/{id}",
          "authRequired": true,
          "allowedRoles": ["SUPER_ADMIN", "ADMIN"]
        },
        "create": {
          "method": "POST",
          "path": "/users",
          "authRequired": true,
          "allowedRoles": ["SUPER_ADMIN", "ADMIN"]
        },
        "update": {
          "method": "PATCH",
          "path": "/users/{id}",
          "authRequired": true,
          "allowedRoles": ["SUPER_ADMIN", "ADMIN"],
          "notes": "Self-update is allowed by backend logic for non-role fields."
        },
        "delete": {
          "method": "DELETE",
          "path": "/users/{id}",
          "authRequired": true,
          "allowedRoles": ["SUPER_ADMIN", "ADMIN"]
        }
      }
    }
  ]
}
