        "delete": {
          "method": "DELETE",
          "path": "/barangays/{id}",
          "authRequired": true,
          "allowedRoles": ["NATIONAL_ADMIN", "REGIONAL_DIRECTOR", "PROVINCIAL_ADMIN", "CITY_ADMIN"],
          "notes": "Delete archives the record when archive mode is enabled. PROVINCIAL_ADMIN and CITY_ADMIN archive access remain scope-limited by the backend."
