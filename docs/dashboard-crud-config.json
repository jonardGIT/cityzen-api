          "authRequired": true,
          "allowedRoles": ["SUPER_ADMIN", "ADMIN"]
        },
        "delete": {
          "method": "DELETE",
          "path": "/statuses/{id}",
          "authRequired": true,
          "allowedRoles": ["SUPER_ADMIN", "ADMIN"]
        }
      }
    },
    {
      "name": "categories",
