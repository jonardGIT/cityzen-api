        },
        "delete": {
          "method": "DELETE",
          "path": "/categories/{id}",
          "authRequired": true,
          "allowedRoles": ["SUPER_ADMIN", "ADMIN"]
        }
      }
    },
    {
      "name": "severities",
      "label": "Severities",
      "primaryKey": "id",
      "routes": {
        "list": { "method": "GET", "path": "/severities", "authRequired": false },
        "get": { "method": "GET", "path": "/severities/{id}", "authRequired": false },
        "create": {
          "method": "POST",
          "path": "/severities",
          "authRequired": true,
          "allowedRoles": ["SUPER_ADMIN", "ADMIN"]
        },
        "update": {
          "method": "PATCH",
