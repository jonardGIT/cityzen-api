{
  "apiBasePath": "/api/v1",
  "auth": {
    "type": "bearer",
    "tokenHeader": "Authorization",
    "tokenPrefix": "Bearer",
    "optionalEndpoints": [
      {
        "operation": "sessions",
        "method": "GET",
        "path": "/auth/sessions",
        "authRequired": true,
        "featureGate": {
          "feature": "tokenMode",
          "requires": "app-jwt"
        },
        "notes": "Available only when tokenMode is app-jwt. Feature-aware OpenAPI output omits session inventory endpoints for other token modes.",
        "fullPath": "/api/v1/auth/sessions"
      },
      {
        "operation": "revokeSession",
        "method": "DELETE",
        "path": "/auth/sessions/{id}",
        "authRequired": true,
        "featureGate": {
          "feature": "tokenMode",
          "requires": "app-jwt"
        },
        "notes": "Available only when tokenMode is app-jwt.",
        "fullPath": "/api/v1/auth/sessions/{id}"
      },
      {
        "operation": "mfaSetup",
        "method": "POST",
        "path": "/auth/mfa/setup",
        "authRequired": true,
        "allowedRoles": [
          "NATIONAL_ADMIN",
          "REGIONAL_DIRECTOR",
          "PROVINCIAL_ADMIN",
          "CITY_ADMIN",
          "CITY_CONTENT_EDITOR",
          "DISPATCHER",
          "AUDITOR"
        ],
        "featureGate": {
          "feature": "mfaMode",
          "requiresAnyOf": [
            "local-totp",
            "supabase-totp"
          ]
        },
        "notes": "Available only when MFA is enabled in the selected feature profile.",
        "fullPath": "/api/v1/auth/mfa/setup"
      },
      {
        "operation": "mfaEnable",
        "method": "POST",
        "path": "/auth/mfa/enable",
        "authRequired": true,
        "allowedRoles": [
          "NATIONAL_ADMIN",
          "REGIONAL_DIRECTOR",
          "PROVINCIAL_ADMIN",
          "CITY_ADMIN",
          "CITY_CONTENT_EDITOR",
          "DISPATCHER",
          "AUDITOR"
        ],
        "featureGate": {
          "feature": "mfaMode",
          "requiresAnyOf": [
            "local-totp",
            "supabase-totp"
          ]
        },
        "notes": "Available only when MFA is enabled in the selected feature profile.",
        "fullPath": "/api/v1/auth/mfa/enable"
      },
      {
        "operation": "mfaDisable",
        "method": "POST",
        "path": "/auth/mfa/disable",
        "authRequired": true,
        "allowedRoles": [
          "NATIONAL_ADMIN",
          "REGIONAL_DIRECTOR",
          "PROVINCIAL_ADMIN",
          "CITY_ADMIN",
          "CITY_CONTENT_EDITOR",
          "DISPATCHER",
          "AUDITOR"
        ],
        "featureGate": {
          "feature": "mfaMode",
          "requiresAnyOf": [
            "local-totp",
            "supabase-totp"
          ]
        },
        "notes": "Available only when MFA is enabled in the selected feature profile.",
        "fullPath": "/api/v1/auth/mfa/disable"
      }
    ]
  },
