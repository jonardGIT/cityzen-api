generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("VIEWER")

  @@map("users")
}

model Citizen {
  id               String            @id @default(uuid()) @db.Uuid
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  name             String
  contactInfo      String
  preferredChannel String
  incidents        CitizenIncident[]

  @@map("citizens")
}

model Agency {
  id            String      @id @default(uuid()) @db.Uuid
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  name          String
  contactNumber String?
  responders    Responder[]

  @@map("agencies")
}

model Responder {
  id          String       @id @default(uuid()) @db.Uuid
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  name        String
  agencyId    String       @db.Uuid
  role        String
  contactInfo String
  agency      Agency       @relation(fields: [agencyId], references: [id])
  assignments Assignment[]

  @@map("responders")
}

model Status {
  id        String            @id @default(uuid()) @db.Uuid
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  name      String
  incidents CitizenIncident[]

  @@map("statuses")
}

model Category {
  id          String            @id @default(uuid()) @db.Uuid
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  name        String
  subCategory String?
  incidents   CitizenIncident[]

  @@map("categories")
}

model Severity {
  id         String            @id @default(uuid()) @db.Uuid
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  level      String            @unique
  definition String?
  incidents  CitizenIncident[]

  @@map("severities")
}

model CitizenIncident {
  id           String       @id @default(uuid()) @db.Uuid
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  description  String
  mediaUrl     String?
  dateReported DateTime     @default(now())
  latitude     Decimal?     @db.Decimal(10, 7)
  longitude    Decimal?     @db.Decimal(10, 7)
  addressLine1 String?
  addressLine2 String?
  barangay     String?
  districtName String?
  cityName     String?
  provinceName String?
  regionName   String?
  postalCode   String?
  landmark     String?
  statusId     String       @db.Uuid
  citizenId    String       @db.Uuid
  categoryId   String       @db.Uuid
  severityId   String       @db.Uuid
  status       Status       @relation(fields: [statusId], references: [id])
  citizen      Citizen      @relation(fields: [citizenId], references: [id])
  category     Category     @relation(fields: [categoryId], references: [id])
  severity     Severity     @relation(fields: [severityId], references: [id])
  assignments  Assignment[]

  @@map("incidents")
}

model Assignment {
  id            String          @id @default(uuid()) @db.Uuid
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  incidentId    String          @db.Uuid
  responderId   String          @db.Uuid
  assignedDate  DateTime        @default(now())
  responseStart DateTime?
  responseEnd   DateTime?
  outcome       String?
  notes         String?
  incident      CitizenIncident @relation(fields: [incidentId], references: [id])
  responder     Responder       @relation(fields: [responderId], references: [id])

  @@map("assignments")
}
