generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String @unique
  passwordHash String
  role         String @default("VIEWER")
}

model Citizen {
  id               String            @id @default(uuid()) @db.Uuid
  name             String
  contactInfo      String
  preferredChannel String
  incidents        CitizenIncident[]

  @@map("citizens")
}

model Agency {
  id            String      @id @default(uuid()) @db.Uuid
  name          String      @unique
  contactNumber String?
  responders    Responder[]

  @@map("agencies")
}

model Responder {
  id          String       @id @default(uuid()) @db.Uuid
  name        String
    agencyId    String
  role        String
  contactInfo String
  assignments Assignment[]
  agency      Agency       @relation(fields: [agencyId], references: [id])

  @@map("responders")
}

model Status {
  id        String            @id @default(uuid()) @db.Uuid
  name      String            @unique
  incidents CitizenIncident[]

  @@map("statuses")
}

model Category {
  id         String            @id @default(uuid()) @db.Uuid
  name       String            @unique
  subCategory String?
  incidents  CitizenIncident[]

  @@map("categories")
}

model Severity {
  id        String            @id @default(uuid()) @db.Uuid
  level     String            @unique
  definition String?
  incidents CitizenIncident[]

  @@map("severities")
}

model Location {
  id       String            @id @default(uuid()) @db.Uuid
  district String
  city     String
  province String
  region   String
  incidents CitizenIncident[]

  @@map("locations")
}

model CitizenIncident {
  id           String     @id @default(uuid()) @db.Uuid
  description  String
  mediaUrl     String?
  dateReported DateTime   @default(now())
    statusId     String
    citizenId    String
    locationId   String
    categoryId   String
    severityId   String
  assignments  Assignment[]

  status   Status   @relation(fields: [statusId], references: [id])
  citizen  Citizen  @relation(fields: [citizenId], references: [id])
  location Location @relation(fields: [locationId], references: [id])
  category Category @relation(fields: [categoryId], references: [id])
  severity Severity @relation(fields: [severityId], references: [id])

  @@map("incidents")
}

model Assignment {
  id           String    @id @default(uuid()) @db.Uuid
  incidentId   String
  responderId  String
  assignedDate DateTime  @default(now())
  responseStart DateTime?
  responseEnd  DateTime?
  outcome      String?
  notes        String?

  incident CitizenIncident @relation(fields: [incidentId], references: [id])
  responder  Responder      @relation(fields: [responderId], references: [id])

  @@map("assignments")
}
