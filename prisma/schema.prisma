generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                    String                  @id @default(uuid()) @db.Uuid
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  archivedAt            DateTime?
  name                  String
  email                 String                  @unique
  passwordHash          String?
  supabaseAuthUserId    String?                 @unique @db.Uuid
  role                  String                  @default("CITIZEN_REPORTER")
  mfaEnabled            Boolean                 @default(false)
  mfaSecretEncrypted    String?
  mfaEnabledAt          DateTime?
  jurisdictionType      String?
  jurisdictionId        String?                 @db.Uuid
  authSessions          AuthSession[]
  incidentStatusChanges IncidentStatusHistory[]
  passwordResetTokens   PasswordResetToken[]

  @@map("users")
}

model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  userId           String    @db.Uuid
  expiresAt        DateTime
  refreshTokenHash String
  refreshExpiresAt DateTime
  refreshUsedAt    DateTime?
  revokedAt        DateTime?
  lastUsedAt       DateTime?
  userAgent        String?
  ipAddress        String?
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([refreshExpiresAt])
  @@index([revokedAt])
  @@map("auth_sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([usedAt])
  @@map("password_reset_tokens")
}

model RateLimitBucket {
  id          String   @id @default(uuid()) @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  bucketKey   String   @unique
  count       Int
  windowStart DateTime
  expiresAt   DateTime

  @@index([expiresAt])
  @@map("rate_limit_buckets")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  timestamp   DateTime @default(now())
  action      String
  summary     String
  outcome     String
  actorUserId String?  @db.Uuid
  actorEmail  String?
  actorRole   String?
  resource    String
  method      String
  path        String
  statusCode  Int?
  targetId    String?
  ipAddress   String?
  userAgent   String?
  requestId   String?
  metadata    Json?

  @@index([timestamp])
  @@index([actorEmail])
  @@index([resource])
  @@index([action])
  @@index([outcome])
  @@index([targetId])
  @@index([requestId])
  @@map("audit_logs")
}

model Citizen {
  id               String            @id @default(uuid()) @db.Uuid
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  archivedAt       DateTime?
  name             String
  contactInfo      String
  preferredChannel String
  incidents        CitizenIncident[]

  @@map("citizens")
}

model Agency {
  id                  String            @id @default(uuid()) @db.Uuid
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  archivedAt          DateTime?
  name                String
  contactNumber       String?
  jurisdictionType    String?
  jurisdictionId      String?           @db.Uuid
  agencyType          String?
  regionId            String?           @db.Uuid
  regionRef           Region?           @relation(fields: [regionId], references: [id])
  provinceId          String?           @db.Uuid
  provinceRef         Province?         @relation(fields: [provinceId], references: [id])
  cityMunicipalityId  String?           @db.Uuid
  cityMunicipalityRef CityMunicipality? @relation(fields: [cityMunicipalityId], references: [id])
  barangayId          String?           @db.Uuid
  barangayRef         Barangay?         @relation(fields: [barangayId], references: [id])
  responders          Responder[]

  @@index([regionId])
  @@index([provinceId])
  @@index([cityMunicipalityId])
  @@index([barangayId])
  @@map("agencies")
}

model Responder {
  id          String       @id @default(uuid()) @db.Uuid
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  archivedAt  DateTime?
  name        String
  agencyId    String       @db.Uuid
  role        String
  contactInfo String
  agency      Agency       @relation(fields: [agencyId], references: [id])
  assignments Assignment[]

  @@map("responders")
}

model Status {
  id                String                  @id @default(uuid()) @db.Uuid
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  archivedAt        DateTime?
  name              String
  incidents         CitizenIncident[]
  fromStatusHistory IncidentStatusHistory[] @relation("IncidentStatusHistoryFromStatus")
  toStatusHistory   IncidentStatusHistory[] @relation("IncidentStatusHistoryToStatus")

  @@map("statuses")
}

model Category {
  id          String            @id @default(uuid()) @db.Uuid
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  archivedAt  DateTime?
  name        String
  subCategory String?
  incidents   CitizenIncident[]

  @@map("categories")
}

model Severity {
  id         String            @id @default(uuid()) @db.Uuid
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  archivedAt DateTime?
  level      String            @unique
  definition String?
  incidents  CitizenIncident[]

  @@map("severities")
}

model CitizenIncident {
  id                  String                  @id @default(uuid()) @db.Uuid
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  archivedAt          DateTime?
  publicReference     String?                 @unique
  description         String
  mediaUrl            String?
  dateReported        DateTime                @default(now())
  latitude            Decimal?                @db.Decimal(10, 7)
  longitude           Decimal?                @db.Decimal(10, 7)
  addressLine1        String?
  addressLine2        String?
  barangay            String?
  districtName        String?
  cityName            String?
  provinceName        String?
  regionName          String?
  postalCode          String?
  landmark            String?
  regionId            String?                 @db.Uuid
  regionRef           Region?                 @relation(fields: [regionId], references: [id])
  provinceId          String?                 @db.Uuid
  provinceRef         Province?               @relation(fields: [provinceId], references: [id])
  cityMunicipalityId  String?                 @db.Uuid
  cityMunicipalityRef CityMunicipality?       @relation(fields: [cityMunicipalityId], references: [id])
  barangayId          String?                 @db.Uuid
  barangayRef         Barangay?               @relation(fields: [barangayId], references: [id])
  statusId            String                  @db.Uuid
  citizenId           String                  @db.Uuid
  categoryId          String                  @db.Uuid
  severityId          String                  @db.Uuid
  status              Status                  @relation(fields: [statusId], references: [id])
  citizen             Citizen                 @relation(fields: [citizenId], references: [id])
  category            Category                @relation(fields: [categoryId], references: [id])
  severity            Severity                @relation(fields: [severityId], references: [id])
  assignments         Assignment[]
  mediaFiles          IncidentMedia[]
  escalations         IncidentEscalation[]
  mutualAidRequests   MutualAidRequest[]
  caseTokens          CaseToken[]
  statusHistory       IncidentStatusHistory[]

  @@index([regionId])
  @@index([provinceId])
  @@index([cityMunicipalityId])
  @@index([barangayId])
  @@map("incidents")
}

model CaseToken {
  id         String          @id @default(uuid()) @db.Uuid
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  archivedAt DateTime?
  incidentId String          @db.Uuid
  tokenHash  String          @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?
  incident   CitizenIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("case_tokens")
}

model IncidentStatusHistory {
  id              String          @id @default(uuid()) @db.Uuid
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  archivedAt      DateTime?
  incidentId      String          @db.Uuid
  fromStatusId    String?         @db.Uuid
  toStatusId      String          @db.Uuid
  changedByUserId String?         @db.Uuid
  note            String?
  incident        CitizenIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  changedByUser   User?           @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)
  fromStatus      Status?         @relation("IncidentStatusHistoryFromStatus", fields: [fromStatusId], references: [id])
  toStatus        Status          @relation("IncidentStatusHistoryToStatus", fields: [toStatusId], references: [id])

  @@index([incidentId, createdAt])
  @@index([fromStatusId])
  @@index([toStatusId])
  @@index([changedByUserId])
  @@map("incident_status_history")
}

model IncidentMedia {
  id           String          @id @default(uuid()) @db.Uuid
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  incidentId   String          @db.Uuid
  mediaUrl     String
  displayOrder Int             @default(0)
  incident     CitizenIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
  @@index([incidentId, displayOrder])
  @@map("incident_media")
}

model Region {
  id          String            @id @default(uuid()) @db.Uuid
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  archivedAt  DateTime?
  code        String            @unique
  name        String
  designation String?
  provinces   Province[]
  incidents   CitizenIncident[]
  agencies    Agency[]

  @@map("regions")
}

model Province {
  id         String             @id @default(uuid()) @db.Uuid
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  archivedAt DateTime?
  code       String             @unique
  name       String
  regionId   String             @db.Uuid
  region     Region             @relation(fields: [regionId], references: [id])
  cities     CityMunicipality[]
  incidents  CitizenIncident[]
  agencies   Agency[]

  @@index([regionId])
  @@map("provinces")
}

model CityMunicipality {
  id         String            @id @default(uuid()) @db.Uuid
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  archivedAt DateTime?
  code       String            @unique
  name       String
  type       String
  provinceId String            @db.Uuid
  province   Province          @relation(fields: [provinceId], references: [id])
  barangays  Barangay[]
  incidents  CitizenIncident[]
  agencies   Agency[]

  @@index([provinceId])
  @@map("cities_municipalities")
}

model Barangay {
  id                 String            @id @default(uuid()) @db.Uuid
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  archivedAt         DateTime?
  code               String            @unique
  name               String
  cityMunicipalityId String            @db.Uuid
  cityMunicipality   CityMunicipality  @relation(fields: [cityMunicipalityId], references: [id])
  incidents          CitizenIncident[]
  agencies           Agency[]

  @@index([cityMunicipalityId])
  @@map("barangays")
}

model IncidentEscalation {
  id            String          @id @default(uuid()) @db.Uuid
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  incidentId    String          @db.Uuid
  incident      CitizenIncident @relation(fields: [incidentId], references: [id])
  fromLevel     String
  toLevel       String
  escalatedById String          @db.Uuid
  reason        String
  status        String

  @@index([incidentId])
  @@index([escalatedById])
  @@map("incident_escalations")
}

model MutualAidRequest {
  id                       String          @id @default(uuid()) @db.Uuid
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt
  incidentId               String          @db.Uuid
  incident                 CitizenIncident @relation(fields: [incidentId], references: [id])
  requestingJurisdictionId String          @db.Uuid
  targetJurisdictionId     String          @db.Uuid
  requestedById            String          @db.Uuid
  status                   String
  notes                    String?

  @@index([incidentId])
  @@index([requestingJurisdictionId])
  @@index([targetJurisdictionId])
  @@map("mutual_aid_requests")
}

model Assignment {
  id            String          @id @default(uuid()) @db.Uuid
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  archivedAt    DateTime?
  incidentId    String          @db.Uuid
  responderId   String          @db.Uuid
  assignedDate  DateTime        @default(now())
  responseStart DateTime?
  responseEnd   DateTime?
  outcome       String?
  notes         String?
  incident      CitizenIncident @relation(fields: [incidentId], references: [id])
  responder     Responder       @relation(fields: [responderId], references: [id])

  @@map("assignments")
}
