generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String               @id @default(uuid()) @db.Uuid
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  archivedAt        DateTime?
  name              String
  email             String               @unique
  passwordHash      String?
  supabaseAuthUserId String?             @unique @db.Uuid
  role              String               @default("CITIZEN_REPORTER")
  mfaEnabled        Boolean              @default(false)
  mfaSecretEncrypted String?
  mfaEnabledAt      DateTime?
  authSessions      AuthSession[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  userId           String    @db.Uuid
  expiresAt        DateTime
  refreshTokenHash String
  refreshExpiresAt DateTime
  refreshUsedAt    DateTime?
  revokedAt        DateTime?
  lastUsedAt       DateTime?
  userAgent        String?
  ipAddress        String?
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([refreshExpiresAt])
  @@index([revokedAt])
  @@map("auth_sessions")
}

model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String   @db.Uuid
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([usedAt])
  @@map("password_reset_tokens")
}

model RateLimitBucket {
  id          String   @id @default(uuid()) @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  bucketKey   String   @unique
  count       Int
  windowStart DateTime
  expiresAt   DateTime

  @@index([expiresAt])
  @@map("rate_limit_buckets")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  timestamp   DateTime @default(now())
  action      String
  summary     String
  outcome     String
  actorUserId String?  @db.Uuid
  actorEmail  String?
  actorRole   String?
  resource    String
  method      String
  path        String
  statusCode  Int?
  targetId    String?
  ipAddress   String?
  userAgent   String?
  requestId   String?
  metadata    Json?

  @@index([timestamp])
  @@index([actorEmail])
  @@index([resource])
  @@index([action])
  @@index([outcome])
  @@index([targetId])
  @@index([requestId])
  @@map("audit_logs")
}

model Citizen {
  id               String            @id @default(uuid()) @db.Uuid
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  archivedAt       DateTime?
  name             String
  contactInfo      String
  preferredChannel String
  incidents        CitizenIncident[]

  @@map("citizens")
}

model Agency {
  id            String      @id @default(uuid()) @db.Uuid
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  archivedAt    DateTime?
  name          String
  contactNumber String?
  responders    Responder[]

  @@map("agencies")
}

model Responder {
  id          String       @id @default(uuid()) @db.Uuid
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  archivedAt  DateTime?
  name        String
  agencyId    String       @db.Uuid
  role        String
  contactInfo String
  agency      Agency       @relation(fields: [agencyId], references: [id])
  assignments Assignment[]

  @@map("responders")
}

model Status {
  id        String            @id @default(uuid()) @db.Uuid
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  archivedAt DateTime?
  name      String
  incidents CitizenIncident[]

  @@map("statuses")
}

model Category {
  id          String            @id @default(uuid()) @db.Uuid
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  archivedAt  DateTime?
  name        String
  subCategory String?
  incidents   CitizenIncident[]

  @@map("categories")
}

model Severity {
  id         String            @id @default(uuid()) @db.Uuid
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  archivedAt DateTime?
  level      String            @unique
  definition String?
  incidents  CitizenIncident[]

  @@map("severities")
}

model CitizenIncident {
  id           String       @id @default(uuid()) @db.Uuid
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  archivedAt   DateTime?
  description  String
  mediaUrl     String?
  dateReported DateTime     @default(now())
  latitude     Decimal?     @db.Decimal(10, 7)
  longitude    Decimal?     @db.Decimal(10, 7)
  addressLine1 String?
  addressLine2 String?
  barangay     String?
  districtName String?
  cityName     String?
  provinceName String?
  regionName   String?
  postalCode   String?
  landmark     String?
  statusId     String       @db.Uuid
  citizenId    String       @db.Uuid
  categoryId   String       @db.Uuid
  severityId   String       @db.Uuid
  status       Status       @relation(fields: [statusId], references: [id])
  citizen      Citizen      @relation(fields: [citizenId], references: [id])
  category     Category     @relation(fields: [categoryId], references: [id])
  severity     Severity     @relation(fields: [severityId], references: [id])
  assignments  Assignment[]
  mediaFiles   IncidentMedia[]

  @@map("incidents")
}

model IncidentMedia {
  id           String          @id @default(uuid()) @db.Uuid
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  incidentId   String          @db.Uuid
  mediaUrl     String
  displayOrder Int             @default(0)
  incident     CitizenIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
  @@index([incidentId, displayOrder])
  @@map("incident_media")
}

model Assignment {
  id            String          @id @default(uuid()) @db.Uuid
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  archivedAt    DateTime?
  incidentId    String          @db.Uuid
  responderId   String          @db.Uuid
  assignedDate  DateTime        @default(now())
  responseStart DateTime?
  responseEnd   DateTime?
  outcome       String?
  notes         String?
  incident      CitizenIncident @relation(fields: [incidentId], references: [id])
  responder     Responder       @relation(fields: [responderId], references: [id])

  @@map("assignments")
}
